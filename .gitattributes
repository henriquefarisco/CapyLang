# CapyLang line-ending policy.
#
# Goldens and source fixtures must use LF on every platform, otherwise the
# byte-level spans produced by the lexer would not match the canonical
# `.tokens` files when contributors check out the repo on Windows with
# `core.autocrlf=true`.

* text=auto eol=lf

*.cl       text eol=lf
*.tokens   text eol=lf
*.rs       text eol=lf
*.toml     text eol=lf
*.md       text eol=lf
*.ebnf     text eol=lf
*.yml      text eol=lf
*.yaml     text eol=lf
Makefile   text eol=lf

# Binary categories that must never be filtered.
*.png      binary
*.jpg      binary
*.jpeg     binary
*.gif      binary
*.ico      binary
